# Supabase project settings (Project Settings > API)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server only. Never expose to the browser.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# Root domain for school subdomains (e.g. brightfuture.simpliskool.com)
NEXT_PUBLIC_ROOT_DOMAIN=simpliskool.com

# Email (absence emails, register reminders). https://resend.com: verify the simpliskool.com domain first.
RESEND_API_KEY=
EMAIL_FROM_ADDRESS=notifications@simpliskool.com
NEXT_PUBLIC_SITE_URL=https://simpliskool.com

# Optional: AI suggestions for report card comments
ANTHROPIC_API_KEY=

# Online fee payments (Paystack): test key first
PAYSTACK_SECRET_KEY=
# SMS (Termii)
TERMII_API_KEY=
TERMII_SENDER_ID=Simpliskool
# Daily job for scheduled announcements (any long random text)
CRON_SECRET=
